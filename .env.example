# Copy this file to .env and fill in the values before running docker-compose.prod.yml
# .env is gitignored — never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=sam
DB_PASS=changeme

# ── OIDC / Keycloak ───────────────────────────────────────────────────────────
# The values below default to the internal Docker network alias ("keycloak") —
# right as long as Keycloak runs in *this* stack (docker-compose.yml's own
# "keycloak" service). Only the two marked "browser-visible" below need an
# externally-reachable address, since only those are ever seen outside the
# stack. If Keycloak instead runs *outside* this stack (e.g. docker-compose.
# prod.yml pointed at a separately managed instance, see ADR-0003), change
# OIDC_SERVER_URL and KEYCLOAK_ADMIN_URL to that instance's reachable address
# too.

# Backend-only: sam-server's own discovery/JWKS calls to Keycloak. Never seen
# by the browser — see OidcConfigResource.java, which uses OIDC_ISSUER_URL
# below for that, not this.
OIDC_SERVER_URL=http://keycloak:8080/realms/sam
# Browser-visible: what /oidc-config.json returns as the token issuer, and
# what Keycloak itself must be reachable at for discovery/login/redirects —
# required by docker-compose.yml (the LAN/all-in-one stack); optional for
# docker-compose.prod.yml, which falls back to OIDC_SERVER_URL when unset
# (see ADR-0010). Must be HTTPS and match KC_HOSTNAME_URL below (same
# host:port).
OIDC_ISSUER_URL=https://sam.example.org/realms/sam
OIDC_CLIENT_ID=sam-ui

# Backend-only: base URL of the Keycloak server for the admin REST client
# (user search) — see CurrentUserService / musician linking.
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=sam
KEYCLOAK_BACKEND_CLIENT_ID=sam-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=changeme

# Browser-visible: Keycloak's own public base URL (docker-compose.yml's
# "keycloak" service only — see ADR-0010) — must be the same host:port as
# OIDC_ISSUER_URL above, without the /realms/sam suffix. A LAN IP works too
# (e.g. https://192.168.1.50:8443), not just a real domain.
KC_HOSTNAME_URL=https://sam.example.org

# ── AI ────────────────────────────────────────────────────────────────────────
# OpenAI API key for document classification (gpt-4o)
OPENAI_API_KEY=sk-...

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container where sheet music files are stored.
# Overriding this changes the Docker volume mount target — update docker-compose.prod.yml accordingly.
# SAM_FILESYSTEM_BASE_PATH=/data/sam
